# Settings for docker-compose.yml. Copy this file to .env and fill it in.

# How Murmur signs in to its built-in Hermes. Required. Make it long and random,
# for example the output of: openssl rand -hex 32
MURMUR_HERMES_PASSWORD=

# Optional. Keeps Murmur signed in to Hermes across Hermes restarts.
# At least 16 characters; Hermes won't start with a shorter one. openssl rand -hex 32
MURMUR_HERMES_SECRET=

# Optional. A password for Murmur itself. Set one before opening Murmur beyond this computer.
MURMUR_PASSWORD=
