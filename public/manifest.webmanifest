{
  "id": "/",
  "name": "Murmur",
  "short_name": "Murmur",
  "description": "A beautiful way to use Hermes",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfbfa",
  "theme_color": "#fbfbfa",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    {
      "name": "New chat",
      "description": "Start a chat with your main agent",
      "url": "/new",
      "icons": [
        { "src": "/shortcut-new-chat.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/shortcut-new-chat-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    }
  ]
}
